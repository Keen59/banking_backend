{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Yarp": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/gateway-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "auth",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "customers": {
        "ClusterId": "customers",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        }
      },
      "accounts": {
        "ClusterId": "accounts",
        "Match": {
          "Path": "/api/accounts/{**catch-all}"
        }
      },
      "ledger": {
        "ClusterId": "ledger",
        "Match": {
          "Path": "/api/ledger/{**catch-all}"
        }
      },
      "payments": {
        "ClusterId": "payments",
        "Match": {
          "Path": "/api/payments/{**catch-all}"
        }
      },
      "notifications": {
        "ClusterId": "notifications",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "cards": {
        "ClusterId": "cards",
        "Match": {
          "Path": "/api/cards/{**catch-all}"
        }
      },
      "risk": {
        "ClusterId": "risk",
        "Match": {
          "Path": "/api/risk/{**catch-all}"
        }
      },
      "loans": {
        "ClusterId": "loans",
        "Match": {
          "Path": "/api/loans/{**catch-all}"
        }
      },
      "openbanking": {
        "ClusterId": "openbanking",
        "Match": {
          "Path": "/api/open-banking/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5229"
          }
        }
      },
      "customers": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5029"
          }
        }
      },
      "accounts": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5039"
          }
        }
      },
      "ledger": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5049"
          }
        }
      },
      "payments": {
        "Destinations": {
